# ─────────────────────────────────────────────────────────────────────────────
# PurpleHat — environment variables
# Copy this file to `.env` (same folder) and fill in the values.
#   Windows:     Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit `.env` — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Groq) — REQUIRED ────────────────────────────────────────────────────
# Create keys at https://console.groq.com/keys
# The app rotates through these four keys when it hits a rate limit (HTTP 429).
# All four MUST be set. If you only have one key, paste the same key four times.
GROQ_API_KEY1=gsk_your_key_here
GROQ_API_KEY2=gsk_your_key_here
GROQ_API_KEY3=gsk_your_key_here
GROQ_API_KEY4=gsk_your_key_here

# Used by the browser-exploration / parsing helpers. REQUIRED (the backend will
# not start without it). May be the same Groq key as above.
API_KEY_pfe=gsk_your_key_here

# Optional: model used by the browser-exploration helper.
# The other agents use MODEL from config.py (default: openai/gpt-oss-120b).
# MODEL=openai/gpt-oss-120b

# ── Authentication — REQUIRED in anything but a throwaway setup ──────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string

# ── PostgreSQL — REQUIRED ────────────────────────────────────────────────────
# These defaults match microservices/infrastructure/docker-compose.yml
# (container "pgvector-db", host port 6000, database "pfe", password "0000").
PFE_DB_HOST=localhost
PFE_DB_PORT=6000
PFE_DB_NAME=pfe
PFE_DB_USER=postgres
PFE_DB_PASSWORD=0000

# ── Report prompt overrides — optional ───────────────────────────────────────
# REPORT_VULN_PROMPT_NAME=pentest_report_vuln_detail
# REPORT_VULN_PROMPT_VERSION=1
# REPORT_SUMMARY_PROMPT_NAME=pentest_report_exec_summary
# REPORT_SUMMARY_PROMPT_VERSION=1
